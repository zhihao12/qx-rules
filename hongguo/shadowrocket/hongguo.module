#!name=红果去广告
#!desc=红果短剧去广告：穿山甲 SDK、字节广告 API、广告素材与埋点拦截。汇总自社区 8 个公开来源交叉验证 + 真机误杀实测。需开启 HTTPS 解密并信任证书（仅重写部分需要）。只启用一份红果去广告模块。
#!homepage=https://github.com/zhihao12/qx-rules/tree/main/hongguo
#!author=zhihao12

[Rule]
# 穿山甲 / Pangle 广告 SDK
DOMAIN-KEYWORD,pangolin,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT
# 字节广告 API
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,ads3-normal-lf.zijieapi.com,REJECT
DOMAIN,ads5-normal-lf.zijieapi.com,REJECT
DOMAIN-WILDCARD,ads*-normal.zijieapi.com,REJECT
DOMAIN-WILDCARD,ads*-normal-lf.zijieapi.com,REJECT
# 广告素材签名域（p3 与抖音商城图片共用，抖音图片异常就删 p3 那行）
DOMAIN,p3-ad-sign.byteimg.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
# 广告跳转与效果追踪
DOMAIN,zlink.ugsdk.cn,REJECT
DOMAIN,zlink.toutiao.com,REJECT
DOMAIN,effect.snssdk.com,REJECT
DOMAIN,ichannel.snssdk.com,REJECT
# 视频广告 CDN（红果与番茄共用）
DOMAIN-WILDCARD,*-reading-ad.qznovelvod.com,REJECT
DOMAIN-WILDCARD,*-iosreadingvideo.qznovelvod.com,REJECT
# 埋点 / 上报
DOMAIN,mon.toutiaocloud.net,REJECT
DOMAIN,mon.toutiaocloud.com,REJECT
DOMAIN,i.snssdk.com,REJECT
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,is.snssdk.com,REJECT
DOMAIN,is-lq.snssdk.com,REJECT
DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN-WILDCARD,*applog.fqnovel.com,REJECT
DOMAIN-WILDCARD,*-misc.fqnovel.com,REJECT

[URL Rewrite]
^https://ads(?:3|5)-normal-lf\.zijieapi\.com(?::443)?/ reject-dict

[MITM]
hostname = %APPEND% ads3-normal-lf.zijieapi.com,ads5-normal-lf.zijieapi.com

# 绝不拦截（拦了红果会转圈卡顿）：tnc*.snssdk.com、tnc*.zijieapi.com、
# security.snssdk.com、security-lq.snssdk.com、mssdk.zijieapi.com、
# gecko3/5.zijieapi.com、lf-*-gr-sourcecdn.bytegecko.com。
# 切勿整域拦截 zijieapi.com、snssdk.com、pstatp.com、bytedance.com。
